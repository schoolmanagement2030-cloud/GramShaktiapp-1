rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          exists(/databases/$(database)/documents/admin_config/setup) && 
          get(/databases/$(database)/documents/admin_config/setup).data.adminUid == request.auth.uid ||
          (request.auth.token.email == "vikas123metro01@gmail.com" && request.auth.token.email_verified == true)
        );
    }

    // ✅ सुधार: Mobile और Pincode को लचीला बनाया गया है ताकि नंबर/स्ट्रिंग दोनों चल सकें
    function isValidWorker(data) {
      return data.keys().hasAll([
        'uid', 'name', 'mobile', 'category', 'subCategory',
        'location', 'pincode', 'village', 'createdAt'
      ]) &&
      data.uid is string &&
      data.name is string && data.name.size() > 0 &&
      data.category is string &&
      data.pincode != null &&
      data.village is string &&
      data.location is map &&
      data.location.lat is number &&
      data.location.lng is number;
    }

    function isValidAd(data) {
      return data.keys().hasAll([
        'uid', 'text', 'adType', 'targetLevel',
        'targetValue', 'plan', 'price',
        'paymentScreenshot', 'status', 'createdAt'
      ]) &&
      data.uid is string &&
      data.adType in ['Local', 'Corporate'] &&
      data.status in ['pending', 'active', 'expired'];
    }

    match /admin_config/setup {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/admin_config/setup);
      allow update, delete: if isAdmin();
    }

    match /workers/{workerId} {
      // ✅ सुरक्षा: केवल लॉगिन वाले लोग ही डेटा देख पाएंगे
      allow read: if isAuthenticated();

      // ✅ सुरक्षा: केवल वही यूजर अपना डेटा डाल पाएगा जो लॉगिन है
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        isValidWorker(request.resource.data);

      allow update: if isOwner(resource.data.uid) &&
        isValidWorker(request.resource.data);

      allow delete: if isOwner(resource.data.uid) || isAdmin();
    }

    match /pending_ads/{adId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.uid);
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /active_banners/{adId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /ad_stats/{adId} {
      allow read: if isAdmin();
      allow create, update: if true; 
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
