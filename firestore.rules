rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          get(/databases/$(database)/documents/admin_config/setup).data.adminUid == request.auth.uid ||
          (request.auth.token.email == "vikas123metro01@gmail.com" && request.auth.token.email_verified == true)
        );
    }

    function isValidWorker(data) {
      return data.keys().hasAll([
        'uid', 'name', 'mobile', 'category', 'skills',
        'location', 'pincode', 'village', 'createdAt'
      ]) &&
      data.uid is string &&
      data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
      data.mobile is string && data.mobile.matches('^[0-9]{10}$') &&
      data.category is string && data.category.size() > 0 &&
      data.skills is string && data.skills.size() < 200 &&
      data.pincode is string && data.pincode.size() == 6 &&
      data.village is string &&
      data.location is map &&
      data.location.lat is number &&
      data.location.lng is number &&
      (data.createdAt is timestamp || data.createdAt is string);
    }

    function isValidAd(data) {
      return data.keys().hasAll([
        'uid', 'text', 'adType', 'targetLevel',
        'targetValue', 'plan', 'price',
        'paymentScreenshot', 'status', 'createdAt'
      ]) &&
      data.uid is string &&
      data.text is string && data.text.size() > 0 && data.text.size() < 500 &&
      data.adType in ['Local', 'Corporate'] &&
      data.targetLevel in ['India', 'State', 'District', 'Tehsil'] &&
      data.targetValue is string &&
      data.plan in [7, 15, 30] &&
      data.price is number &&
      data.paymentScreenshot is string &&
      data.status in ['pending', 'active', 'expired'] &&
      (data.createdAt is timestamp || data.createdAt is string);
    }

    function isValidAdStats(data) {
      return data.keys().hasAll([
        'adId', 'views_count', 'click_count',
        'call_action_count', 'lastUpdated'
      ]) &&
      data.adId is string &&
      data.views_count is number &&
      data.click_count is number &&
      data.call_action_count is number &&
      (data.lastUpdated is timestamp || data.lastUpdated is string);
    }

    match /admin_config/setup {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/admin_config/setup);
      allow update, delete: if isAdmin();
    }

    match /workers/{workerId} {
      allow read: if true;

      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        isValidWorker(request.resource.data);

      allow update: if isOwner(resource.data.uid) &&
        request.resource.data.uid == resource.data.uid &&
        isValidWorker(request.resource.data);

      allow delete: if isOwner(resource.data.uid);
    }

    match /pending_ads/{adId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.uid);

      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        isValidAd(request.resource.data);

      allow update, delete: if isAdmin();
    }

    match /active_banners/{adId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /ad_stats/{adId} {
      allow read: if isAdmin();

      allow create: if isValidAdStats(request.resource.data);

      allow update: if isValidAdStats(request.resource.data) &&
        request.resource.data.adId == resource.data.adId;
    }

    match /ad_requests/{requestId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == userId || isAdmin());

      allow write: if isAuthenticated() &&
        request.auth.uid == userId;
    }
  }
}
